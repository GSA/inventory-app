# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
language-settings:
  python: "3.10"
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-PYTHON-SETUPTOOLS-17895075:
    - "*":
        reason: >-
          Not affected. CVE-2026-59890 only triggers when setuptools applies
          MANIFEST.in exclusion directives while building a source distribution
          on a macOS APFS/HFS+ filesystem, via Unicode filename normalization
          collisions. This app builds and runs exclusively in Linux containers
          and does not build source distributions. The fix is only in
          setuptools>=83.0.0, which is uninstallable here because CKAN 2.11.5
          caps setuptools<82. https://github.com/GSA/data.gov/issues/6167
        expires: 2027-09-10T00:00:00.000Z
        created: 2026-09-11T00:00:00.000Z
  SNYK-PYTHON-BLEACH-17356127:
    - "*":
        reason: >-
          Not affected. bleach is a CKAN-core-only dependency; CKAN imports
          bleach.clean, never linkify, and no installed package calls
          linkify(parse_email=True), so the vulnerable
          LinkifyFilter.handle_email_addresses() path is unreachable. No fixed
          bleach version exists. https://github.com/GSA/data.gov/issues/6122
        expires: 2027-09-10T00:00:00.000Z
        created: 2026-07-01T00:00:00.000Z
patch: {}
# specify the directories or files to be excludeed from import:
exclude:
 global:
   - requirements-dev.txt
   # Third-party submodules. GSA/dcat-us ships its own package.json and
   # pyproject.toml that `all_projects: true` would claim as ours; it scans itself.
   - _external/**
